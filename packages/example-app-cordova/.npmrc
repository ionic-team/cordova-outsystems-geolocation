# This app depends on its own parent plugin repo via a self-referential "file:../.." path.
# npm's default for file: dependencies is a live symlink into node_modules, which would include
# this very directory again (self-reference) -- causing an infinite copy loop the moment Cordova's
# plugin installer (a plain recursive fs.cpSync with no ignore-file support) copies it. This
# setting makes npm pack-and-extract the dependency instead (respecting the parent repo's
# .npmignore, which excludes this directory), producing a clean, self-contained copy.
install-links=true
